            <gradient android:type="linear" android:startX="82" android:startY="90" android:endX="44" android:endY="68">
                <item android:offset="0.0" android:color="#00D2FF"/>
                <item android:offset="0.5" android:color="#0A84FF"/>
                <item android:offset="1.0" android:color="#003D8A"/>
            </gradient>
