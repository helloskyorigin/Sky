    </path>
    
    <!-- Central Glowing Star (Vertical) -->
    <path android:pathData="M64,48 L66,62 L80,64 L66,66 L64,80 L62,66 L48,64 L62,62 Z" android:fillColor="#FFFFFF"/>
    
    <!-- Central Glowing Star Glow -->
    <path android:pathData="M64,46 L67,61 L82,64 L67,67 L64,82 L61,67 L46,64 L61,61 Z" android:fillColor="#6600D2FF"/>
