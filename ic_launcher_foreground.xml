    <!-- Bottom Blue Swoosh of the 'S' -->
    <path android:pathData="M44,80 C56,96 78,90 82,74 C84,66 80,60 72,58 L72,66 C78,68 80,72 78,76 C76,84 60,86 54,76 C52,72 50,70 44,80 Z">
