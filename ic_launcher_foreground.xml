    </path>

    <!-- Right side highlight/reflection for 3D effect -->
    <path android:pathData="M64,12 L106,28 L106,59 C106,85 82,108 64,114 L64,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="64" android:startY="12" android:endX="106" android:endY="59">
                <item android:offset="0.0" android:color="#1A00D2FF"/>
                <item android:offset="1.0" android:color="#330A84FF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Silver Swoosh of the 'S' -->
    <path android:pathData="M84,48 C72,32 50,38 46,54 C44,62 48,68 56,70 L56,62 C50,60 48,56 50,52 C52,44 68,42 74,52 C76,56 78,58 84,48 Z">
