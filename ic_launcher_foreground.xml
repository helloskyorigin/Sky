<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Outer metallic shield border -->
    <path android:pathData="M64,6 L112,24 L112,60 C112,90 85,115 64,122 C43,115 16,90 16,60 L16,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="16" android:startY="6" android:endX="112" android:endY="122">
                <item android:offset="0.0" android:color="#E0E5EC"/>
                <item android:offset="0.3" android:color="#7A8599"/>
                <item android:offset="0.6" android:color="#404A5E"/>
                <item android:offset="1.0" android:color="#1F2633"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer electric blue glow/accent -->
    <path android:pathData="M64,6 L112,24 L112,60 C112,90 85,115 64,122 C43,115 16,90 16,60 L16,24 Z"
          android:strokeWidth="2" android:strokeColor="#0A84FF" android:strokeAlpha="0.7"/>

